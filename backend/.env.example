# Never commit real credentials. Generate JWT_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
GOOGLE_APPLICATION_CREDENTIALS=firebase-credentials.json
FIREBASE_WEB_API_KEY=
CORS_ORIGINS=
ENVIRONMENT=development

# Flutterwave v3 hosted checkout. Begin with test keys.
PAYMENTS_ENABLED=false
FLW_SECRET_KEY=
FLW_SECRET_HASH=
PAYMENT_RETURN_URL=https://your-domain.example/payment-complete.html
